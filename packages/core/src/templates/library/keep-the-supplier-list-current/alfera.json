    {
      "capability": "update the entries that have drifted",
      "risk": "changes_data"
    }
  ],
  "requires": [
    {
      "requirement_kind": "app_connection",
      "requirement_key": "google_sheets",
      "requirement_label": "Google Sheets",
      "is_optional": false,
      "requirement_config": {
        "explain_to_the_installer": "The supplier list it maintains."
      }
    },
    {
      "requirement_kind": "app_connection",
      "requirement_key": "gmail",
      "requirement_label": "Gmail",
      "is_optional": false,
      "requirement_config": {
        "explain_to_the_installer": "The correspondence it checks against."
      }
    }
  ],
  "asks_you_for": [
    {
      "input_key": "supplier_list",
      "label": "The supplier list",
      "input_type": "document"
