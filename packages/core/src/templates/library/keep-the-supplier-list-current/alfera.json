{
  "sidecar_version": 1,
  "outcome_text": "A supplier list that is true, so quoting off it stops being a gamble.",
  "summary_text": "Check prices, contacts, and lead times against what suppliers sent.",
  "icon": "📇",
  "listing_state": "ready",
  "facets": [
    {
      "facet_kind": "category",
      "facet_key": "operations",
      "is_primary": true
    },
    {
      "facet_kind": "role",
      "facet_key": "operations-managers",
      "is_primary": false
    }
  ],
  "what_you_get": [
    "Prices checked against the last invoice",
    "Contacts who stopped replying, flagged",
    "Lead times that quietly doubled",
    "An audit column saying what changed"
  ],
  "what_it_does": [
    "Checks each price against the most recent actual invoice",
    "Notices when the named contact stopped replying",
    "Flags lead times that have quietly doubled",
    "Leaves an audit column saying what changed and from where"
  ],
  "it_will_be_able_to": [
    {
      "capability": "read the list and recent supplier email",
