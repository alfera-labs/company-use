{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@coworker/ui/*": ["./src/*"],
      "@coworker/shared": ["../shared/src/index.ts"],
      "@shared/*": ["../shared/src/*.ts", "../shared/src/*/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
