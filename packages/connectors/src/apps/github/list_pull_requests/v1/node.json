{
  "node_key": "github-list_pull_requests-1",
  "display_name": "List GitHub Pull Requests",
  "description": "List pull requests across one or more GitHub repositories. Every repository returns its own array of pull requests and its own next_cursor; send that cursor back on the same repository to read the next page.",
  "implementation": "execute",
  "atomic": false,
  "required_scopes": ["repo"],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repos": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "description": "The repositories to read, one provider call each.",
        "items": {
          "type": "object",
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "repo": { "type": "string", "minLength": 1 },
            "full_name": {
              "type": "string",
              "minLength": 3,
              "description": "The repository as owner/repo, which is the option id github-list_repos-1 hands the picker. Send this, or send owner and repo."
            },
            "cursor": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "description": "The page cursor this repository returned last time."
            }
          },
          "anyOf": [{ "required": ["full_name"] }, { "required": ["owner", "repo"] }]
        }
      },
      "state": { "type": "string", "enum": ["open", "closed", "all"] },
      "base_branch": {
        "type": "string",
        "description": "Filter by the branch a pull request merges into, e.g. \"main\"."
      }
    },
    "required": ["repos"]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repos": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": { "type": "integer" },
            "owner": { "type": "string" },
            "repo": { "type": "string" },
            "ok": { "type": "boolean" },
            "pull_requests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": { "type": "integer" },
                  "title": { "type": "string" },
                  "state": { "type": "string" },
                  "html_url": { "type": "string" },
                  "body": { "type": ["string", "null"] },
                  "draft": { "type": "boolean" },
                  "author": { "type": ["string", "null"] },
                  "head_branch": { "type": ["string", "null"] },
                  "base_branch": { "type": ["string", "null"] },
                  "created_time": { "type": "string" },
                  "last_updated_time": { "type": "string" },
                  "merged_time": { "type": ["string", "null"] }
                },
                "required": [
                  "number",
                  "title",
                  "state",
                  "html_url",
                  "body",
                  "draft",
                  "author",
                  "head_branch",
                  "base_branch",
                  "created_time",
                  "last_updated_time",
                  "merged_time"
                ]
              }
            },
            "next_cursor": { "type": ["string", "null"] },
            "error": {
              "type": ["object", "null"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "retryable": { "type": "boolean" }
              },
              "required": ["code", "message", "retryable"]
            }
          },
          "required": ["index", "owner", "repo", "ok", "pull_requests", "next_cursor", "error"]
        }
      }
    },
    "required": ["repos"]
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Lenient ingress on GET /repos/{owner}/{repo}/pulls. Reads the fields the node maps and lets GitHub keep adding the rest.",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "number": { "type": "number" },
        "title": { "type": "string" },
        "state": { "type": "string" },
        "html_url": { "type": "string" },
        "body": { "type": ["string", "null"] },
        "draft": { "type": ["boolean", "null"] },
        "user": {
          "type": ["object", "null"],
          "properties": { "login": { "type": "string" } },
          "required": ["login"]
        },
        "head": {
          "type": ["object", "null"],
          "properties": { "ref": { "type": "string" } },
          "required": ["ref"]
        },
        "base": {
          "type": ["object", "null"],
          "properties": { "ref": { "type": "string" } },
          "required": ["ref"]
        },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "merged_at": { "type": ["string", "null"] }
      },
      "required": ["number", "title", "state", "html_url", "created_at", "updated_at"]
    }
  },
  "quirks": {
    "endpoint": "GET /repos/{owner}/{repo}/pulls",
    "why_execute": "Same shape as github-list_issues-1: a fan-out over repositories with a cursor and an outcome per repository, which a declarative http mapping cannot express.",
    "filters": "The filters differ from github-list_issues-1 because the endpoints differ. The pull request endpoint takes no `labels` and no `since`, so this node does not pretend to accept them; it takes `base_branch` instead.",
    "pagination": "Page cursor with a full page as the signal that another page exists, the same as github-list_issues-1."
  }
}
