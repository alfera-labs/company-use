  "quirks": {
    "endpoint": "POST /v2/objects/{object}/records/query",
    "pagination": "Attio takes limit and offset in the request body and returns no cursor of its own. next_cursor is the next offset written as a string, and a page shorter than limit ends the walk.",
    "values": "Attio keys every value by attribute slug and shapes it by attribute type. Each record goes out twice: attributes holds one readable entry per slug, values holds exactly what Attio sent.",
    "rate_limits": "This endpoint also carries a complexity score. A heavy filter or sort on a large object can be rate limited on its own, whatever the request rate."
