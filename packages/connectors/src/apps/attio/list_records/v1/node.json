{
  "node_key": "attio-list_records-1",
  "display_name": "List Attio Records",
  "description": "List Attio records for one object — companies, people, deals, or any custom object slug — with optional filter and sorts. Returns a page of records and a cursor for the next page, or a null cursor when the page is the last one. Each record carries its readable attributes and the raw Attio values.",
  "implementation": "execute",
  "required_scopes": ["record_permission:read", "object_configuration:read"],
