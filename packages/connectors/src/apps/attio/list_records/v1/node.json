    "type": "object",
    "properties": {
      "object": {
        "type": "string",
        "minLength": 1,
        "description": "The object's slug or id, for example 'companies', 'people' or 'deals'."
      },
      "filter": {
        "description": "Attio's filter object, for example { name: 'Ada Lovelace' }.",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "sorts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": ["asc", "desc"]
            },
            "attribute": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          },
          "required": ["direction"],
          "additionalProperties": {}
        }
      },
      "cursor": {
        "description": "The next_cursor from the previous page. Omit for the first page.",
        "type": "string",
        "pattern": "^\\d+$"
      },
      "limit": {
        "default": 100,
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 500
      }
    },
    "required": ["object"]
  },
