{
  "node_key": "granola-read_notes-1",
  "display_name": "Read Notes",
  "description": "Read a batch of Granola meeting notes by id. Returns each note's AI summary as text and markdown, the owner, the attendees, the calendar event, and the folders it lives in. Ids come from granola-list_notes-1 and look like not_00000000000001. A note the key cannot see is reported in errors instead of failing the batch. Transcripts are not included \u2014 use granola-read_transcripts-1.",
  "required_scopes": ["personal_notes", "public_notes"],
  "implementation": "execute",
  "provider": {
    "endpoint": "GET /v1/notes/{note_id}",
    "docs": "https://docs.granola.ai/api-reference/get-note",
    "openapi": "https://docs.granola.ai/api-reference/openapi.json"
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["note_ids"],
    "additionalProperties": false,
    "properties": {
      "note_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "The note ids to read, such as not_00000000000001. Granola reads one note per call, so the batch runs as bounded concurrent singles."
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["notes", "errors"],
    "additionalProperties": false,
    "$defs": {
      "person": {
        "type": "object",
        "required": ["name", "email"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "properties": {
      "notes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "owner",
            "created_at",
            "updated_at",
            "web_url",
            "summary_text",
            "summary_markdown",
            "private_notes_text",
            "private_notes_markdown",
            "attendees",
            "folders",
            "calendar_event"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": ["string", "null"]
            },
            "owner": {
              "$ref": "#/$defs/person"
            },
            "created_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            },
            "web_url": {
              "type": ["string", "null"],
              "description": "The note in the Granola web app."
            },
            "summary_text": {
              "type": ["string", "null"],
              "description": "Granola's AI summary as plain text."
            },
            "summary_markdown": {
              "type": ["string", "null"],
              "description": "The same summary in markdown. Null when the note has none."
            },
            "private_notes_text": {
              "type": ["string", "null"],
              "description": "What the note's owner typed themselves. Null unless the key belongs to that person."
            },
            "private_notes_markdown": {
              "type": ["string", "null"],
              "description": "The same private notes in markdown."
            },
            "attendees": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/person"
              }
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "parent_folder_id"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": ["string", "null"]
                  },
                  "parent_folder_id": {
                    "type": ["string", "null"]
                  }
                }
              }
            },
            "calendar_event": {
              "type": ["object", "null"],
              "required": [
                "event_title",
                "organiser_email",
                "calendar_event_id",
                "scheduled_start_time",
                "scheduled_end_time",
                "invitee_emails"
              ],
              "additionalProperties": false,
              "properties": {
                "event_title": {
                  "type": ["string", "null"]
                },
                "organiser_email": {
                  "type": ["string", "null"]
                },
                "calendar_event_id": {
                  "type": ["string", "null"]
                },
                "scheduled_start_time": {
                  "type": ["string", "null"]
                },
                "scheduled_end_time": {
                  "type": ["string", "null"]
                },
                "invitee_emails": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "errors": {
        "type": "array",
        "description": "One entry per note that could not be read. The other notes still return.",
        "items": {
          "type": "object",
          "required": ["note_id", "code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "note_id": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "GET /v1/notes/{note_id}. Lenient on purpose. Granola's OpenAPI document marks most of these required, but a node that dies on a vendor's new null returns nothing at all.",
    "type": "object",
    "required": ["id", "created_at", "updated_at"],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": ["string", "null"]
      },
      "owner": {
        "type": ["object", "null"],
        "properties": {
          "name": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"]
          }
        }
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "web_url": {
        "type": ["string", "null"]
      },
      "summary_text": {
        "type": ["string", "null"]
      },
      "summary_markdown": {
        "type": ["string", "null"]
      },
      "private_notes_text": {
        "type": ["string", "null"]
      },
      "private_notes_markdown": {
        "type": ["string", "null"]
      },
      "attendees": {
        "type": ["array", "null"],
        "items": {
          "type": ["object", "null"],
          "properties": {
            "name": {
              "type": ["string", "null"]
            },
            "email": {
              "type": ["string", "null"]
            }
          }
        }
      },
      "folder_membership": {
        "type": ["array", "null"],
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": ["string", "null"]
            },
            "parent_folder_id": {
              "type": ["string", "null"]
            }
          }
        }
      },
      "calendar_event": {
        "type": ["object", "null"],
        "properties": {
          "event_title": {
            "type": ["string", "null"]
          },
          "organiser": {
            "type": ["string", "null"]
          },
          "calendar_event_id": {
            "type": ["string", "null"]
          },
          "scheduled_start_time": {
            "type": ["string", "null"]
          },
          "scheduled_end_time": {
            "type": ["string", "null"]
          },
          "invitees": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    }
  },
  "quirks": {
    "why_execute": "Granola reads one note per call, so the plural contract runs through the runtime's fan_out: bounded concurrent singles under the app's rate limits, one result per id, in the caller's order.",
    "provider_ingress": "The lenient JSON Schema ingress on the provider's own payload is response_schema above. The runtime compiles it and runs it on the way in; execute.ts only names the shape it guaranteed.",
    "no_inline_transcript": "The node never sends ?include=transcript. An inline transcript can come back as 413 TRANSCRIPT_TOO_LARGE, which would turn one unlucky long meeting into a failed batch. Transcripts belong to granola-read_transcripts-1, which pages them. https://docs.granola.ai/api-reference/get-note",
    "private_notes": "Granola returns private_notes_* only when the key belongs to the person who created the note. Shared notes and workspace keys read null.",
    "missing_notes": "A note that is still being processed, or that the key cannot see, answers 404 and lands in errors."
  }
}
