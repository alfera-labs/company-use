# Self-host configuration. Copy to `deploy/.env` and fill the marked values.
#
#   cp .env.selfhost.example .env
#
# Every name here is read by the schemas in packages/config/src, by
# apps/app/src/runtime_env_keys.json, or by docker-compose.yml in this folder. A name that is
# absent from all three does nothing.
#
# Do NOT add PORT here. The API and app containers read the same name, so docker-compose.yml
# sets it per service. Use APP_PORT / API_PORT below to choose the published host ports.

# ---------------------------------------------------------------------------
# YOU MUST FILL ONE MODEL KEY, OR THE ADDRESS OF A MODEL YOU HOST
# ---------------------------------------------------------------------------

# One model provider key. Fill exactly one of the three; leave the others empty.
# Anthropic is the default for agent runs and the browser harness.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=

# Or a model you host, or any other server that speaks the OpenAI chat completions API
# (Ollama, LM Studio, vLLM, llama.cpp, OpenRouter). Fill the address and the model name. The
# address is the one that ends in /v1. A server on this machine is at host.docker.internal, not
# at localhost, because the request comes from a container. The model must support tool
# calling. When the address is set, the coworker runs on it, even when a key above is set.
# See "Use a model you host" in SELF_HOSTING.md for what does not work with it.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
# Only when the server asks for a key.
OPENAI_COMPATIBLE_API_KEY=
# The context window your server gives the model, in tokens. Empty means 32768.
OPENAI_COMPATIBLE_CONTEXT_WINDOW=
# Set to true when the model reads images. Empty means text only.
OPENAI_COMPATIBLE_READS_IMAGES=

# ---------------------------------------------------------------------------
# WHO MAY USE IT
# ---------------------------------------------------------------------------

# Every request needs a session. `team` signs people in with one-time links this install makes
# itself, with no outside account. The first person is the owner: install.sh prints and opens
# the owner's link, and `./alfera team link` makes a fresh one.
#
# APP_BIND=127.0.0.1 keeps the dashboard port on this machine. `./alfera add team` sets
# 0.0.0.0, asks for the address people open, and then the owner invites people in
# Settings -> Team. Both WORKOS values below must stay empty in this mode.
#
# For single sign-on, leave COWORKER_AUTH_MODE empty and hand sign-in to WorkOS (the free tier
# is enough). Create an application at https://dashboard.workos.com, fill the two WORKOS
# values, set APP_BIND=0.0.0.0, and register this redirect URI in WorkOS -> Redirects:
#   http://localhost:3000/auth/callback
# The app derives the callback from the incoming request host, so a custom domain needs its
# own redirect URI registered (https://alfera.example.com/auth/callback) and nothing else.
COWORKER_AUTH_MODE=team
APP_BIND=127.0.0.1
# The first name the owner is greeted with. Optional.
COWORKER_LOCAL_USER_NAME=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ---------------------------------------------------------------------------
# GENERATED SECRETS — install.sh fills these with `openssl rand -hex 32`
# ---------------------------------------------------------------------------
# These are local keys, not credentials from any vendor. Generate them yourself when you
# write this file by hand.

# Authenticates the app -> API proxy and machine-only API routes. Minimum 16 characters.
# Never leave this empty: an empty value makes both sides fall back to a shared
# well-known development string.
COWORKER_API_PROXY_SECRET=
# Seals the `wos-session` cookie. 32+ characters.
WORKOS_COOKIE_PASSWORD=
# Master key for persistent agent-browser session files. Exactly 64 hex characters.
COWORKER_BROWSER_STATE_ENCRYPTION_KEY=
# Admin token of the Rivet Engine service. The API and the worker sign in to the engine with it.
RIVET_TOKEN=

# ---------------------------------------------------------------------------
# RUNTIME SHAPE
# ---------------------------------------------------------------------------

# Production mode sets the `Secure` attribute on session cookies. Browsers accept those on
# http://localhost; any other hostname must be served over HTTPS (see SELF_HOSTING.md).
NODE_ENV=production
ENVIRONMENT=production
NEXT_PUBLIC_ENVIRONMENT=production

# This install is self-hosted. Without this switch a production build accepts only the cloud
# sandbox and refuses to start.
COWORKER_SELF_HOSTED=true
# Each agent session gets its own sibling container on the host Docker daemon.
COWORKER_WORKSPACE_RUNTIME_PROVIDER=docker
# Where agent workspace files live ON THE HOST. docker-compose.yml mounts this path at the
# same path inside the API and worker containers, because the sibling container's bind mount
# is resolved by the host daemon. Must be absolute and writable by uid 1000.
COWORKER_WORKSPACE_HOST_PATH=/var/lib/coworker/workspaces
COWORKER_WORKSPACE_BASE_PATH=/var/lib/coworker/workspaces
# The group that owns /var/run/docker.sock, as a container sees it. SELF_HOSTING.md has the
# command that reads it.
DOCKER_GROUP_ID=999
# The Docker network every sandbox container is on, apart from this stack's own network. The
# worker makes it on first use. Name a network you made yourself to choose its address range.
COWORKER_SANDBOX_NETWORK=alfera-sandbox
# `closed` leaves a sandbox the public internet and no private address: not the containers of
# this stack, not another sandbox, not this machine at a private address, not your own network.
# A public address of this machine is part of the internet, so with https on a sandbox reaches
# the install there like any stranger: with no session and no key. `open` gives private
# addresses back, for a coworker that must reach a service on your network, or a Docker that
# cannot change routes.
COWORKER_SANDBOX_PRIVATE_ADDRESSES=closed
# Where a closed sandbox looks names up. Public resolvers, because the one Docker would pick
# can sit at a private address that is closed. `docker` leaves the choice to Docker.
COWORKER_SANDBOX_DNS=1.1.1.1,9.9.9.9
# `closed` refuses an MCP server on this machine or on a private network, like Alfera Cloud
# does. `open` lets an owner or an admin add one in the dashboard, over plain http too. The API
# and the worker then send requests to the private addresses they name. The coworker can never
# add one by itself, and a cloud metadata address stays refused. `./alfera add local-mcp` sets it.
COWORKER_MCP_PRIVATE_ADDRESSES=closed

# The API queues jobs and the worker container runs them. The Rivet Engine container carries
# the queue between the two. `engine` is the compose service name.
EVENT_JOB_DISPATCH_MODE=rivet
RIVET_ENDPOINT=http://engine:6420
RIVET_NAMESPACE=default
# Maximum runs at once in the worker container.
QUEUE_WORKER_MAX_CONCURRENT_RUNS=8
WORKSPACE_MAX_CONCURRENT_RUNS=2
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# `postgres` is the compose service name. The password inside DATABASE_URL must match
# POSTGRES_PASSWORD; change both together or the API cannot sign in to the database.
POSTGRES_USER=coworker
POSTGRES_PASSWORD=coworker
POSTGRES_DB=coworker
DATABASE_URL=postgres://coworker:coworker@postgres:5432/coworker

# ---------------------------------------------------------------------------
# URLS AND PORTS
# ---------------------------------------------------------------------------

# Published host ports. Change these to move the stack off 3000/3001.
APP_PORT=3000
API_PORT=3001

# How the app container reaches the API container. `api` is the compose service name; 3001 is
# the fixed in-container port. The browser never uses this: it calls the app's own origin at
# /api, which the app proxies.
API_URL=http://api:3001
API_PUBLIC_URL=

# Public origins. Set both to your real URL when you put the stack behind a domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Legacy name the app still declares as required. Keep it equal to the value above.
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# CORS allow-list for the API. Add every origin the app is served from.
ALLOWED_ORIGINS=http://localhost:3000

# HTTPS on ports 80 and 443, off by default. `./deploy/install.sh --https` and
# `./alfera add https [name]` fill these and the origins above. COMPOSE_PROFILES=https starts
# the Caddy container of docker-compose.yml. ALFERA_PUBLIC_HOST is the name people open: a
# domain of yours, or a name made from this machine's public address (203-0-113-7.sslip.io).
COMPOSE_PROFILES=
ALFERA_PUBLIC_HOST=
# One line of Caddy global options, empty as a rule. `email you@example.com` also lets Caddy
# ask a second certificate authority when the first refuses. `local_certs` makes Caddy sign
# the certificate itself, for a name no authority can reach; a browser then warns.
CADDY_GLOBAL_OPTIONS=

# Cookies stay host-only. Setting this shares the sign-in hint across sub-domains; leave it
# empty unless you run several hosts on one parent domain.
AUTH_HINT_COOKIE_DOMAIN=
# WORKOS_COOKIE_DOMAIN is rejected by the build on purpose. Do not add it.

# ---------------------------------------------------------------------------
# DEPLOY PAGE (optional)
# ---------------------------------------------------------------------------

# The /deploy page of this install makes a new Alfera server in a cloud account of the
# visitor. It works only on https. Empty values keep it off. See "One-click deploy" in
# SELF_HOSTING.md.
# Origins that may call the deploy routes of this API, for example https://acme-203-0-113-7.sslip.io
COMPANY_USE_DEPLOY_PAGE_ORIGINS=
# A DigitalOcean OAuth app whose callback URL is <your origin>/deploy.
COMPANY_USE_DIGITALOCEAN_CLIENT_ID=
# The Alfera release the page installs: a tag of the public repository. Empty means main.
COMPANY_USE_VERSION=
# The https address of a copy of deploy/aws/alfera-ec2.yaml in an S3 bucket.
COMPANY_USE_AWS_TEMPLATE_URL=

# ---------------------------------------------------------------------------
# MODELS
# ---------------------------------------------------------------------------

# Defaults from the schema. Override only to pin a different model.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-luna
VERCEL_AI_GATEWAY_MODEL=zai/glm-4.6
# Lets agent runs use the models of OpenRouter and the Vercel AI Gateway. Your own key pays for them.
MODEL_GATEWAY_UNLOCKED=true
# The model list comes from a snapshot inside the image. Set this to true and the API fetches
# a newer list from https://models.dev/api.json once a day.
MODEL_CATALOG_REFRESH=false

# ---------------------------------------------------------------------------
# OFF BY DEFAULT — leave empty to keep the feature dormant
# ---------------------------------------------------------------------------

# Error reports. Empty means none leaves the machine.
SENTRY_DSN=
API_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Managed cloud sandboxes and durable workspace volumes. Self-hosting uses the local Docker
# daemon instead, so these stay empty.
COWORKER_PERSISTENT_WORKSPACES_ENABLED=false
E2B_API_KEY=
ARCHIL_API_KEY=
ARCHIL_REGION=

# Chat uploads and tool artifacts. They are kept on this machine, in the `coworker_files`
# Docker volume mounted at the path below. Do not change the path: the compose file mounts
# the volume there.
COWORKER_FILE_STORAGE_PATH=/var/lib/coworker/files
# To keep them in an S3-compatible bucket instead, fill these four. A bucket wins over the
# folder above.
ARTIFACT_UPLOAD_BUCKET=
R2_BUCKET_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Outbound email. Empty means notifications are logged, not sent.
RESEND_API_KEY=
INBOUND_EMAIL_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=

# Slack, WorkOS webhooks, and connector OAuth clients. Add a pair only for the integration
# you want. .env.example at the repository root lists every CONNECTOR_*_CLIENT_ID pair.
WORKOS_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# The hosted app catalogue, from your own Composio account. See "Connect your apps" in
# SELF_HOSTING.md.
COMPOSIO_API_KEY=
# The signing secret of the webhook subscription of that Composio project. Automations that
# start on an app event need it, and a public address. See "Automations" in SELF_HOSTING.md.
COMPOSIO_WEBHOOK_SECRET=

# Optional web-search providers for the research tools. With FIRECRAWL_API_KEY or JINA_API_KEY
# the coworker also reads a web page through that service. With neither, it fetches the page
# itself.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=

# ---------------------------------------------------------------------------
# RELEASE
# ---------------------------------------------------------------------------

# Image tag every service pulls. Empty means `latest`. Pin a release tag (vX.Y.Z) to upgrade
# deliberately.
PRODUCT_VERSION=
# Override to pull from your own registry.
# API_IMAGE=ghcr.io/alfera-labs/alfera-api
# APP_IMAGE=ghcr.io/alfera-labs/alfera-app

# silent, error, warn, info, debug. Unset means info.
LOG_LEVEL=
