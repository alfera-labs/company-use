{
  "license": "AGPL-3.0-only",
  "name": "coworker",
  "version": "0.2.7.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <26.0.0 || >=26.1.0 <27",
    "bun": ">=1.4.2 <2"
  },
  "scripts": {
    "dev": "bash scripts/dev-server.sh dev",
    "dev:portless": "bash scripts/dev-portless.sh",
    "dev:start": "bash scripts/dev-server.sh start",
    "dev:stop": "bash scripts/dev-server.sh stop",
    "dev:restart": "bash scripts/dev-server.sh restart",
    "dev:status": "bash scripts/dev-server.sh status",
    "dev:logs": "bash scripts/dev-server.sh logs",
    "build": "NODE_ENV=production turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check . && bun run lint:boundaries",
    "lint:boundaries": "bun run lint:ratchet && bun --no-env-file scripts/check-jobs-does-not-import-product.ts --self-test && bun --no-env-file scripts/check-jobs-does-not-import-product.ts && bun --no-env-file scripts/check-memory-does-not-import-product.ts --self-test && bun --no-env-file scripts/check-memory-does-not-import-product.ts && bun --no-env-file scripts/check-memory-steps-match-core.ts --self-test && bun --no-env-file scripts/check-memory-steps-match-core.ts && bun --no-env-file scripts/check-rivetkit-stays-in-worker.ts --self-test && bun --no-env-file scripts/check-rivetkit-stays-in-worker.ts && bun run lint:theme && bun run lint:ui-styling && bun run lint:no-comments-in-program-packages && bun run lint:corrections",
    "lint:no-comments-in-program-packages": "bun --no-env-file scripts/check-no-comments-in-program-packages.ts --self-test && bun --no-env-file scripts/check-no-comments-in-program-packages.ts",
    "lint:no-comments-in-program-packages:update": "bun --no-env-file scripts/check-no-comments-in-program-packages.ts --update",
    "lint:ratchet": "bun --no-env-file scripts/ratchet/run_ratchet.ts --self-test && bun --no-env-file scripts/ratchet/run_ratchet.ts",
    "lint:ratchet:update": "bun --no-env-file scripts/ratchet/run_ratchet.ts --update",
    "lint:ratchet:list": "bun --no-env-file scripts/ratchet/list_violations.ts",
    "lint:corrections": "bun run lint:sandbox-credentials && bun run lint:pooler-session-set && bun run lint:live-test-workspaces && bun run lint:key-shaped-values",
    "lint:key-shaped-values": "bun --no-env-file scripts/check-key-shaped-values-are-filler.ts --self-test && bun --no-env-file scripts/check-key-shaped-values-are-filler.ts",
    "lint:sandbox-credentials": "bun --no-env-file scripts/check-no-credentials-in-sandbox.ts --self-test && bun --no-env-file scripts/check-no-credentials-in-sandbox.ts",
    "lint:pooler-session-set": "bun --no-env-file scripts/check-no-session-set-through-pooler.ts --self-test && bun --no-env-file scripts/check-no-session-set-through-pooler.ts",
    "lint:live-test-workspaces": "bun --no-env-file scripts/check-live-tests-use-test-workspaces.ts --self-test && bun --no-env-file scripts/check-live-tests-use-test-workspaces.ts",
    "lint:live-test-workspaces:update": "bun --no-env-file scripts/check-live-tests-use-test-workspaces.ts --update",
    "lint:theme": "bun --no-env-file scripts/check-theme-covers-shadcn-dark.ts --self-test && bun --no-env-file scripts/check-theme-covers-shadcn-dark.ts",
    "lint:ui-styling": "bun --no-env-file scripts/check-ui-keeps-alfera-styling.ts --self-test && bun --no-env-file scripts/check-ui-keeps-alfera-styling.ts",
    "lint:ui-styling:update": "bun --no-env-file scripts/check-ui-keeps-alfera-styling.ts --update",
    "test": "bash scripts/test-env.sh vitest run --maxWorkers=1",
    "test:memory-gates": "bun --no-env-file node_modules/vitest/vitest.mjs run --config packages/memory/vitest.config.ts packages/memory/src/evals/suites",
    "test:fast": "bash scripts/test-env.sh vitest run --maxWorkers=4",
    "test:dev-env": "bun --no-env-file node_modules/vitest/vitest.mjs run",
    "test:persistent-workspace:live": "env NODE_ENV=test COWORKER_ARCHIL_LIVE_TEST_ENABLED=true COWORKER_PERSISTENT_WORKSPACES_ENABLED=true COWORKER_WORKSPACE_RUNTIME_PROVIDER=e2b bun --no-env-file node_modules/vitest/vitest.mjs run --maxWorkers=1 packages/runtime-platform/src/__tests__/archil_e2b_live.test.ts packages/runtime-platform/src/__tests__/overlapping_runs_live.test.ts",
    "playwright:test": "playwright test",
    "db:start": "bash scripts/db-start.sh",
    "db:setup": "bash scripts/db-start.sh && bun run db:migrate && bun run catalog:seed local && bun run db:catalog:restore",
    "db:catalog:dump": "bash scripts/catalog-dump.sh",
    "db:catalog:restore": "bash scripts/catalog-restore.sh",
    "db:stop": "docker compose --env-file .env.local down",
    "db:destroy": "bash scripts/db-destroy.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --no-env-file scripts/migrate.ts",
    "e2b:build-template": "bun --no-env-file infra/e2b/build-template.ts",
    "e2b:verify-template": "bun --no-env-file infra/e2b/verify-template.ts",
    "workspace-volumes": "bun --no-env-file scripts/workspace_volumes.ts",
    "connectors:index": "bun --no-env-file scripts/generate-connector-index.ts",
    "backfill:personal-rooms": "bun --no-env-file scripts/backfill_personal_rooms.ts",
    "backfill:connection-sharing": "bun --no-env-file scripts/backfill_connection_sharing.ts",
    "backfill:run-event-payloads": "bun --no-env-file scripts/backfill_run_event_payloads.ts",
    "catalog:seed": "bash scripts/catalog.sh seed",
    "catalog:inventory": "bash scripts/catalog.sh inventory",
    "connectors:check-recipes": "bash scripts/catalog.sh check-recipes",
    "catalog:plan": "bash scripts/catalog.sh plan",
    "catalog:apply": "bash scripts/catalog.sh apply",
    "sync:models-dev": "bun --no-env-file scripts/sync-models-dev-snapshot.ts",
    "seed:library": "bun --no-env-file scripts/seed-library.ts",
    "test:script-imports": "bun test ./scripts/lib/scripts_resolve_their_imports.test.ts",
    "test:app-build-scripts": "node --test apps/app/scripts/*.test.mjs",
    "test:repo-scripts": "node --test scripts/*.test.mjs",
    "db:studio": "drizzle-kit studio",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "boot": "bash scripts/boot.sh",
    "worktree:remove": "bash scripts/worktree-remove.sh",
    "dev:proxy": "bash scripts/dev-proxy.sh",
    "dotenvx": "dotenvx"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@dotenvx/dotenvx": "^1.51.1",
    "@electric-sql/pglite": "^0.4.5",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.8",
    "e2b": "^2.27.0",
    "happy-dom": "^20.11.2",
    "openai": "^4.104.0",
    "openapi-types": "^12.1.3",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@coworker/config": "workspace:*",
    "@coworker/shared": "workspace:*",
    "postgres": "^3.4.9",
    "zod": "^4.2.1"
  },
  "overrides": {
    "@smithy/core": "3.31.1",
    "tar": ">=7.5.21"
  }
}
