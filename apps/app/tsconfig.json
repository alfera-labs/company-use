{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/app/src/*"],
      "@coworker/api": ["apps/api/src/index.ts"],
      "@coworker/config": ["packages/config/src/env.ts"],
      "@coworker/config/constants": ["packages/config/src/constants.ts"],
      "@coworker/config/env": ["packages/config/src/env.ts"],
      "@coworker/config/public_env": ["packages/config/src/public_env.ts"],
      "@coworker/connectors": ["packages/connectors/src/index.ts"],
      "@connectors": ["packages/connectors/src/index.ts"],
      "@connectors/*": [
        "packages/connectors/src/*.ts",
        "packages/connectors/src/*/index.ts",
        "packages/connectors/src/*"
      ],
      "@coworker/memory": ["packages/memory/src/index.ts"],
      "@coworker/memory/*": ["packages/memory/src/*.ts", "packages/memory/src/*/index.ts"],
      "@coworker/runtime-platform": ["packages/runtime-platform/src/index.ts"],
      "@coworker/shared": ["packages/shared/src/index.ts"],
      "@coworker/ui/components/*": ["packages/ui/src/components/*.tsx"],
      "@coworker/ui/lib/*": ["packages/ui/src/lib/*.ts"],
      "@coworker/ui/hooks/*": ["packages/ui/src/hooks/*.ts"],
      "@api/services/models/model_ratings.json": [
        "apps/api/src/services/models/model_ratings.json"
      ],
      "@api/*": ["apps/api/src/*.ts", "apps/api/src/*/index.ts"],
      "@agent-core": ["packages/agent-core/src/index.ts"],
      "@agent-core/llm_gateway/models_dev_snapshot.json": [
        "packages/agent-core/src/llm_gateway/models_dev_snapshot.json"
      ],
      "@agent-core/*": ["packages/agent-core/src/*.ts", "packages/agent-core/src/*/index.ts"],
      "@shared/*": ["packages/shared/src/*.ts", "packages/shared/src/*/index.ts"],
      "@runtime-platform": ["packages/runtime-platform/src/index.ts"],
      "@runtime-platform/*": ["packages/runtime-platform/src/*.ts"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "incremental": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules"]
}
