{
  "license": "AGPL-3.0-only",
  "name": "@coworker/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "documents:assets": "node scripts/copy_document_viewer_assets.mjs",
    "prebuild": "bun run documents:assets",
    "predev": "bun run documents:assets",
    "predev:portless": "bun run documents:assets",
    "dev": "PORT=${APP_PORT:-3000} dotenvx run -f ../../.env.keys -f ../../.env.local -f ../../.env.development -- vite dev --port ${APP_PORT:-3000} --strictPort",
    "dev:portless": "dotenvx run -f ../../.env.keys -f ../../.env.local -f ../../.env.development -- portless run --name app --force vite dev",
    "build": "vite build",
    "start": "dotenvx run -f ../../.env.keys -f ../../.env.local -f ../../.env.development -- vite preview --port ${PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun --no-env-file ../../node_modules/vitest/vitest.mjs run --root ../.. --config vitest.config.ts apps/app/src"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.76",
