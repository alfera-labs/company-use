NODE_ENV=development
ENVIRONMENT=development
NEXT_PUBLIC_ENVIRONMENT=development
# Verbosity dial for the API + runtime logger. Unset = info (the operational story: queue
# started, jobs queued, run-now-vs-wait, concurrency, boot). Set to debug for the firehose
# (per-request HTTP lines, heartbeats, payload dumps); error/silent to quiet it down.
# LOG_LEVEL=info
API_PORT=3001
# API origin. HTTP event-job dispatch posts durable work back to this service so the hosting
# platform can observe demand and scale it.
API_URL=http://localhost:3001
API_PUBLIC_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://app.localhost:3000/auth/callback
SENTRY_DSN=
API_SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
DB_PORT=55432
DATABASE_URL=postgres://coworker:coworker@localhost:55432/coworker
ALLOWED_ORIGINS=http://app.localhost:3000,http://localhost:3000
# For development only: `local` runs with no sign-in, and the dashboard then answers only a
# request that names localhost. Never use it on an install other people or the coworker's
# sandbox can reach: a self-host uses `team`, which deploy/install.sh writes. Unset means
# sign-in through WorkOS.
# COWORKER_AUTH_MODE=local
# The first name local mode greets the person with. Optional.
# COWORKER_LOCAL_USER_NAME=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://app.localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
# OAuth server for MCP clients (ChatGPT, Claude, Cursor): the AuthKit domain. Empty = API keys only.
MCP_OAUTH_ISSUER=
# Required for machine-only routes and HTTP event-job dispatch. Use at least 16 random characters.
COWORKER_API_PROXY_SECRET=
COWORKER_CREDENTIAL_ENCRYPTION_KEY=
# `rivet`: only queue workers (apps/worker) on Rivet run jobs; the API writes rows and rings.
# `in_process` is for unit tests only: the API server refuses it. `http` is the older deployed mode.
EVENT_JOB_DISPATCH_MODE=rivet
# Maximum event-job subject runs per API instance (`http` mode only).
WORKER_MAX_CONCURRENT_RUNS=1
# Maximum queue runs at once in one queue worker process (apps/worker, `rivet` mode).
# 8 = one 4 GiB instance; measure before raising.
QUEUE_WORKER_MAX_CONCURRENT_RUNS=8
# Maximum chat queues (web chat messages) one process runs at once, apart from the budget above.
WORKER_MAX_CONCURRENT_CHAT_RUNS=8
DATABASE_POOL_MAX=4
WORKSPACE_MAX_CONCURRENT_RUNS=2
COMPOSIO_API_KEY=
ENCRYPTION_MASTER_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SESSION_TITLE_MODEL=
OPENAI_SESSION_SUMMARY_MODEL=
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini
OPENAI_EVALUATION_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SESSION_TITLE_MODEL=
ANTHROPIC_SESSION_SUMMARY_MODEL=
ANTHROPIC_CLASSIFICATION_MODEL=
ANTHROPIC_EVALUATION_MODEL=
# A model you host, or another OpenAI-compatible address, in place of a key. It is used only
# with COWORKER_SELF_HOSTED=true. A server on this machine is at http://localhost:11434/v1 when
# the API runs outside Docker. See "Use a model you host" in SELF_HOSTING.md.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_MODEL=zai/glm-4.6
VERCEL_AI_GATEWAY_SESSION_TITLE_MODEL=
VERCEL_AI_GATEWAY_SESSION_SUMMARY_MODEL=
VERCEL_AI_GATEWAY_CLASSIFICATION_MODEL=
VERCEL_AI_GATEWAY_EVALUATION_MODEL=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
# Native connector OAuth clients. One pair per app, filled from the vendor portal.
# Attio OAuth app, Developers -> Build an integration.
CONNECTOR_ATTIO_CLIENT_ID=
CONNECTOR_ATTIO_CLIENT_SECRET=
# GitHub App, Settings -> Developer settings -> GitHub Apps.
CONNECTOR_GITHUB_CLIENT_ID=
CONNECTOR_GITHUB_CLIENT_SECRET=
# HubSpot public app, developer account -> Apps -> Auth.
CONNECTOR_HUBSPOT_CLIENT_ID=
CONNECTOR_HUBSPOT_CLIENT_SECRET=
# Notion public integration, notion.so/profile/integrations.
CONNECTOR_NOTION_CLIENT_ID=
CONNECTOR_NOTION_CLIENT_SECRET=
# Salesforce connected app consumer key and secret, Setup -> App Manager.
CONNECTOR_SALESFORCE_CLIENT_ID=
CONNECTOR_SALESFORCE_CLIENT_SECRET=
# Slack's connector runs on the first-party Slack app below (SLACK_CLIENT_ID / SLACK_CLIENT_SECRET).
# Granola takes a pasted API key per workspace, so it has no client here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
# Optional encrypted worktree-local defaults. `bun run setup:worktree` copies non-empty
# LOCAL_FOO to FOO in generated .env.local, then blanks LOCAL_FOO in .env.local.
LOCAL_SLACK_CLIENT_ID=
LOCAL_SLACK_CLIENT_SECRET=
LOCAL_SLACK_SIGNING_SECRET=
COMPUTE_PROVIDER=
FLY_API_TOKEN=
FLY_ORG=
FLY_REGION=
GCP_PROJECT_ID=
GCP_REGION=
MEMORY_IMPORT_BUCKET=
# A folder that keeps uploaded files and tool artifacts when no bucket is set below. A bucket
# name that is set wins over the folder.
# COWORKER_FILE_STORAGE_PATH=
# Browser-writable R2 bucket for chat uploads and tool artifacts. Needs a CORS rule
# allowing PUT and GET from the dashboard origins.
ARTIFACT_UPLOAD_BUCKET=
R2_BUCKET_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GCP_SCHEDULER_TARGET_BASE_URL=
GCP_ZONE=
AWS_REGION=us-west-1
AWS_SCHEDULER_GROUP=default
AWS_SCHEDULER_LAMBDA_ARN=
AWS_SCHEDULER_ROLE_ARN=
AWS_AUTH_ROLE_ARN=
GCP_OIDC_AUDIENCE=
GATEWAY_DEVICE_PRIVATE_KEY=
WARM_POOL_ENABLED=0
WARM_POOL_REFILL_INTERVAL_MS=
WARM_POOL_MAX_CONCURRENT_PROVISIONS=
WARM_POOL_CLAIM_EXPIRES_SECONDS=
DEV_DEBUG_ENABLED=0
# Notifications (email via Resend). RESEND_API_KEY unset in dev = emails are logged, not sent.
RESEND_API_KEY=
# Automated notifications come from the brand; the welcome email can come from a named person.
NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_REPLY_TO_EMAIL=
NOTIFICATIONS_FOUNDER_FROM_EMAIL=
NOTIFICATIONS_FOUNDER_REPLY_TO_EMAIL=
# Managed workspace email (Resend Inbound). The shared receiving domain (e.g. inbox.example.com);
# unset = email channel off. The webhook secret is the Svix whsec_ for the email.received endpoint.
INBOUND_EMAIL_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=
# Emails one workspace's agent may send per rolling day (default 200). Runtime-owned closing
# messages are never capped — only agent-initiated sends.
EMAIL_DAILY_SEND_LIMIT=
LLM_METERING_DISABLED=0
COWORKER_WORKSPACE_RUNTIME_PROVIDER=docker
COWORKER_WORKSPACE_BASE_PATH=
# Durable workspace storage. Production uses E2B compute + one Archil-backed volume per
# workspace backed by a workspace-prefixed R2 bucket.
COWORKER_PERSISTENT_WORKSPACES_ENABLED=0
E2B_API_KEY=
ARCHIL_API_KEY=
ARCHIL_REGION=
R2_BUCKET_NAME=
R2_BUCKET_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 64 hex characters (`openssl rand -hex 32`); only derived per-workspace keys
# are passed to agent-browser.
COWORKER_BROWSER_STATE_ENCRYPTION_KEY=
# Destructive non-production provider acceptance test. Keep disabled outside a
# dedicated Archil/R2 test account and bucket.
COWORKER_ARCHIL_LIVE_TEST_ENABLED=0
COWORKER_MODAL_ENDPOINT_URL=
COWORKER_MODAL_AUTH_TOKEN=
# Lets a workspace admin add an MCP server by URL. Off means no new server can be
# added; MCP tools already in the catalog keep resolving and executing either way.
# Only for an authorization server that will not register a client dynamically.
# Keyed by server_key, e.g. {"githubcopilot":"Iv1.abc123"}. Every server that
# supports RFC 7591 registration — which is all of them but GitHub today — needs
# no entry here.
COWORKER_MCP_OAUTH_CLIENT_IDS=
# Anthropic deferred tool loading. `tools` is the first thing in the cache prefix, so the whole
# tool block is billed on every model call: 39 tools cost 9,119 tokens a call against 2,524 for the
# eight below, with the rest still reachable through the provider's tool search. Off by default and
# ignored on non-Anthropic providers, which do not understand `defer_loading`. Two variables so the
# tuned list survives switching the feature off and on. An empty list defers nothing.
COWORKER_DEFER_MODEL_TOOLS=0
COWORKER_ALWAYS_LOADED_MODEL_TOOLS=workspace-run_command,workspace-read_file,workspace-write_file,workspace-edit_file,workspace-grep,workspace-list_files,runtime-execute_tool-1,browser
COWORKER_TRACE_AGENT_IO=0
COWORKER_TRACE_AGENT_STREAM=0
# The deploy page: /deploy of the app. COMPANY_USE_DEPLOY_PAGE_ORIGINS lists the origins that
# serve it, comma separated, for example http://localhost:3000. The DigitalOcean OAuth app
# needs <origin>/deploy as its callback URL. See "One-click deploy" in SELF_HOSTING.md.
COMPANY_USE_DEPLOY_PAGE_ORIGINS=
COMPANY_USE_DIGITALOCEAN_CLIENT_ID=
COMPANY_USE_VERSION=
COMPANY_USE_AWS_TEMPLATE_URL=
COMPANY_USE_TEST_OVERRIDES=
