<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The one exception to the hardened runtime that Electron needs: its JavaScript engine
         writes machine code at run time. The app asks for no camera, microphone or location. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
