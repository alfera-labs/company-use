{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_ENVIRONMENT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "NEXT_PUBLIC_MARKETING_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_RELEASE",
    "SENTRY_DEBUG"
  ],
  "globalPassThroughEnv": [
    "WORKTREE_NAME",
    "PORT",
    "HOST",
    "MARKETING_PORT",
    "WWW_PORT",
    "API_PORT",
    "APP_PORT",
    "DB_PORT",
    "API_URL",
    "DATABASE_URL",
    "ALLOWED_ORIGINS",
    "NEXT_PUBLIC_MARKETING_URL",
    "AUTH_HINT_COOKIE_DOMAIN",
    "COWORKER_TEST_LOGIN_ENABLED",
    "CHOKIDAR_USEPOLLING",
    "CHOKIDAR_INTERVAL",
    "NODE_OPTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".output/**",
        ".vercel/output/**",
        ".tanstack/**"
      ]
    },
    "@agent-core#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coworker/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coworker/config#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coworker/core#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coworker/runtime-platform#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@coworker/shared#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:portless": {
      "cache": false,
      "persistent": true
    },
    "dev:marketing": {
      "cache": false,
      "persistent": true
    },
    "dev:www": {
      "cache": false,
      "persistent": true
    },
    "dev:marketing:portless": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
